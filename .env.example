# Copy this file to `.env` and fill in values. `.env` is gitignored and never
# rsync'd by scripts/deploy.sh — secrets and host-specific paths stay local.

# ── Required: host paths bind-mounted into the container ──
# OMO_COMICS_PATH:  read-only comic library on the host
# OMO_DATA_PATH:    writable directory for SQLite DB + thumbnail cache
OMO_COMICS_PATH=
OMO_DATA_PATH=

# ── Optional: deploy target (used by scripts/deploy.sh) ──
# Where deploy.sh rsyncs the repo to. Leave unset if you don't use deploy.sh.
OMO_DEPLOY_HOST=
OMO_DEPLOY_PATH=

# ── Optional: bearer token for /api/* ──
# Leave empty when running behind a private VPN (Tailscale, WireGuard, etc.) —
# tailnet membership is already the access control.
# Set a long random value (e.g. `openssl rand -hex 32`) for any deployment
# reachable from the public internet.
OMO_AUTH_TOKEN=
