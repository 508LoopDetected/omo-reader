# Copy this file to `.env` next to docker-compose.yml.
# `.env` is gitignored and never scp'd, so secrets stay on the host.

# Optional bearer token for /api/* (header or ?token= query).
# Leave empty when running behind a private VPN (Tailscale, WireGuard, etc.) —
# tailnet membership is already the access control.
# Set a long random value (e.g. `openssl rand -hex 32`) for any deployment
# reachable from the public internet.
OMO_AUTH_TOKEN=
