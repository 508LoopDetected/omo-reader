# Prefer `./omo setup` — this file is just a fallback for hand-rolled configs.
# Copy to `.env` and fill in. `.env` is gitignored; the remote target's `.env`
# is never overwritten by the deploy step.

# ── Where to run ──
# local: docker compose up on this machine
# ssh:   build locally, ship image over SSH, run on the remote
OMO_DEPLOY_TARGET=local

# ── Bind-mounted host paths (on the target machine) ──
# Comics: read-only library
# Data:   writable directory for SQLite DB + thumbnail cache
OMO_COMICS_PATH=
OMO_DATA_PATH=

# ── Bearer token for /api/* ──
# Empty = no auth (fine behind a private VPN like Tailscale). Set a long random
# value (e.g. `openssl rand -hex 32`) for anything reachable from the internet.
OMO_AUTH_TOKEN=

# ── Required when OMO_DEPLOY_TARGET=ssh ──
# SSH target ("user@host") and the directory on the remote where
# docker-compose.yml + .env live.
OMO_DEPLOY_HOST=
OMO_DEPLOY_PATH=
